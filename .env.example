# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Both values come from Supabase:
#   Project Settings -> Database -> Connection string  (URI mode)
#   Project Settings -> API           -> anon public key

# The pooled Postgres connection string. Use the "Session pooler"
# (port 5432) or the direct connection — NOT the transaction
# pooler (port 6543), which does not support prepared statements.
# On Windows, append ?sslmode=require
#
# NOTE: the Supabase free tier publishes IPv6-only direct hostnames,
# so this may be unreachable from an IPv4-only machine. See the
# "Applying the schema with no IPv4" section of README.md, and use
# supabase/apply_all.sql in the dashboard's SQL editor instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# There is deliberately NO SUPABASE_ANON_KEY here.
#
# This application does not use Supabase Auth or the Data API
# (PostgREST). It connects straight to Postgres and authenticates in
# src/auth.py with its own bcrypt password hashing, so the anon key
# is never needed and is not read anywhere in the code.
#
# That is also why Row Level Security is not enabled: RLS does not
# apply to the table owner, and the app connects as that owner, so a
# policy would be silently bypassed by every statement. The real
# exposure worth closing is the Data API, which supabase/hardening.sql
# addresses by revoking the anon and authenticated roles.
# ---------------------------------------------------------------------

# Set to "local" to use the local PostgreSQL 17 instance instead,
# which is handy for development without touching the cloud database.
# DB_TARGET=local
# LOCAL_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/school_validation